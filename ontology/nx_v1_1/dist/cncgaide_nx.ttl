cg:HOLE_SPACING a cg:RelationType ;
    rdfs:label "HOLE_SPACING" ;
    skos:definition "The axes of the two hole-like features are parallel; the relation carries their perpendicular offset." ;
    cg:allowedPair [ cg:first nx:STEP ;
            cg:second nx:STEP ],
        [ cg:first nx:STEP ;
            cg:second nx:HOLES ],
        [ cg:first nx:HOLES ;
            cg:second nx:HOLES ] ;
    cg:directed false ;
    cg:method "arithmetic over X/Y/Z_POSITION and X/Y/Z_ORIENTATION_D" .

