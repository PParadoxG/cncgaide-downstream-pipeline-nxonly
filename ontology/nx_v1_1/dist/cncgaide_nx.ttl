cg:derived_floor_thickness a owl:DatatypeProperty ;
    rdfs:label "floor thickness" ;
    rdfs:range xsd:decimal ;
    skos:definition "Remaining material below the floor of the feature, from the floor to the nearest opposing face of the part." ;
    cg:appliesTo nx:POCKET_CLOSED,
        nx:POCKET_FREE_SHAPED_STRAIGHT,
        nx:POCKET_OBROUND_CURVED_STRAIGHT,
        nx:POCKET_OBROUND_STRAIGHT,
        nx:POCKET_OPEN,
        nx:POCKET_RECTANGULAR_STRAIGHT,
        nx:POCKET_ROUND_TAPERED,
        nx:STEP1POCKET,
        nx:STEP2POCKET,
        nx:STEP3POCKET,
        nx:STEP4POCKET,
        nx:STEP5POCKET,
        nx:STEP6POCKET ;
    cg:derivedQuantity true ;
    cg:method "ray cast from the floor faces along the access direction to the first opposing surface" ;
    cg:unit "mm" .

