cg:LOCATED_ON a cg:RelationType ;
    rdfs:label "LOCATED_ON" ;
    skos:definition "An opening of the source feature resolves outward to exactly one host face, owned by the target feature." ;
    cg:allowedPair [ cg:first nx:STEP ;
            cg:second nx:MachiningFeature ],
        [ cg:first nx:HOLES ;
            cg:second nx:MachiningFeature ],
        [ cg:first nx:POCKETS ;
            cg:second nx:MachiningFeature ],
        [ cg:first nx:BOSSES ;
            cg:second nx:MachiningFeature ],
        [ cg:first nx:SLOTS ;
            cg:second nx:MachiningFeature ],
        [ cg:first nx:CORNER_NOTCHES ;
            cg:second nx:MachiningFeature ],
        [ cg:first nx:SIDE_NOTCHES ;
            cg:second nx:MachiningFeature ],
        [ cg:first nx:GROOVES ;
            cg:second nx:MachiningFeature ] ;
    cg:directed false ;
    cg:method "B-Rep topology of the faces the two features own" .

cg:t_floor a cg:Threshold ;
    rdfs:label "t_floor" ;
    skos:definition "Minimum remaining floor thickness below a pocket or a blind hole." ;
    cg:unit "mm" ;
    cg:value 2.0 .

