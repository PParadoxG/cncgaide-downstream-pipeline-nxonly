nx:TURNING_GROOVE a owl:Class ;
    rdfs:label "Turning Groove" ;
    rdfs:subClassOf nx:TurningFeature ;
    cg:abstract false ;
    cg:declaresAttribute nx:BOTTOM_RADIUS,
        nx:BOTTOM_RADIUS_2,
        nx:BOTTOM_RADIUS_2_LOWER,
        nx:BOTTOM_RADIUS_2_UPPER,
        nx:BOTTOM_RADIUS_LOWER,
        nx:BOTTOM_RADIUS_UPPER ;
    cg:recognisable false .

cg:INTERSECTS a cg:RelationType ;
    rdfs:label "INTERSECTS" ;
    skos:definition "The removal volumes of two hole-like features meet, proven by a B-Rep edge their walls share." ;
    cg:allowedPair [ cg:first nx:STEP ;
            cg:second nx:STEP ],
        [ cg:first nx:STEP ;
            cg:second nx:HOLES ],
        [ cg:first nx:HOLES ;
            cg:second nx:HOLES ] ;
    cg:directed false ;
    cg:method "B-Rep topology of the faces the two features own" .

cg:POCKET_CLEARANCE a cg:RelationType ;
    rdfs:label "POCKET_CLEARANCE" ;
    skos:definition "Shortest remaining material distance between the side walls of two pockets whose wall sets are separated." ;
    cg:allowedPair [ cg:first nx:POCKETS ;
            cg:second nx:POCKETS ] ;
    cg:directed false ;
    cg:method "kernel distance between the two side-wall face sets" .

cg:SLOT_CLEARANCE a cg:RelationType ;
    rdfs:label "SLOT_CLEARANCE" ;
    skos:definition "Shortest distance between the opening boundaries of two slots whose boundaries are separated." ;
    cg:allowedPair [ cg:first nx:SLOTS ;
            cg:second nx:SLOTS ] ;
    cg:directed false ;
    cg:method "B-Rep topology and polyline distance of the two opening boundaries" .

cg:derived_min_clearance a owl:DatatypeProperty ;
    rdfs:label "minimum clearance" ;
    rdfs:range xsd:decimal ;
    skos:definition "Shortest free distance from the side walls of the feature to any other material of the part." ;
    cg:appliesTo nx:BOSS_RECTANGULAR_STRAIGHT,
        nx:BOSS_ROUND_STRAIGHT,
        nx:BOSS_ROUND_STRAIGHT_THREAD ;
    cg:derivedQuantity true ;
    cg:method "ray cast from sampled side-wall normals away from the material to the first other surface" ;
    cg:unit "mm" .

