            cg:onClass nx:STEP6HOLE2_THREAD ],
        [ cg:attribute nx:DIAMETER_1 ;
            cg:onClass nx:STEP6HOLE_THREAD ],
        [ cg:attribute nx:DIAMETER_1 ;
            cg:onClass nx:STEP6POCKET ],
        [ cg:attribute nx:DIAMETER_1 ;
            cg:onClass nx:STEP6POCKET_THREAD ] ;
    cg:scope "pair" ;
    cg:statement "Keep the material web between two parallel holes, the axis spacing minus the mean of the two entry diameters, at or above t_hole_web." ;
    cg:usesAttributePattern "DIAMETER_1" ;
    cg:usesRelation cg:HOLE_SPACING ;
    cg:usesThreshold cg:t_hole_web .

cg:H13 a cg:Heuristic ;
    rdfs:label "Hole coaxial with its boss" ;
    cg:affectsKpi cg:kpi_workpiece_stiffness ;
    cg:appliesTo nx:BOSS_ROUND_STRAIGHT,
        nx:BOSS_ROUND_STRAIGHT_THREAD ;
    cg:appliesToPattern "BOSS_ROUND_STRAIGHT",
        "BOSS_ROUND_STRAIGHT_THREAD" ;
    cg:condition """{ SELECT ?f (COUNT(DISTINCT ?h) AS ?v_holeCount) (COUNT(DISTINCT ?hc) AS ?v_coaxialHoleCount) WHERE {
    GRAPH <{FACTS}> { ?loc cg:relationType cg:LOCATED_ON ; cg:terminal ?t .
                      ?t cg:hostOwner ?f ; cg:terminalFeature ?h . ?h a ?hcls }
    GRAPH <{ONTOLOGY}> { ?hcls rdfs:subClassOf* ?fam }
    VALUES ?fam { nx:STEP nx:HOLES }
    OPTIONAL { GRAPH <{FACTS}> { ?cx cg:relationType cg:COAXIAL .
                                 { ?cx cg:from ?h ; cg:to ?f } UNION { ?cx cg:from ?f ; cg:to ?h } }
               BIND(?h AS ?hc) }
  } GROUP BY ?f }
FILTER(?v_holeCount > 0)
BIND(IF(?v_coaxialHoleCount > 0, cg:PASS, cg:FAIL) AS ?outcome)
""" ;
    cg:publishesValue "coaxialHoleCount",
        "holeCount" ;
    cg:scope "feature" ;
    cg:statement "When a hole is located on a round boss, at least one hole located on that boss is coaxial with it." ;
    cg:usesRelation cg:COAXIAL,
        cg:LOCATED_ON .

cg:H15 a cg:Heuristic ;
    rdfs:label "Minimum pocket-to-pocket clearance" ;
    cg:affectsKpi cg:kpi_collision_indicator,
        cg:kpi_workpiece_stiffness ;
    cg:appliesTo nx:POCKET_CLOSED,
        nx:POCKET_FREE_SHAPED_STRAIGHT,
        nx:POCKET_OBROUND_CURVED_STRAIGHT,
        nx:POCKET_OBROUND_STRAIGHT,
        nx:POCKET_OPEN,
        nx:POCKET_RECTANGULAR_STRAIGHT,
        nx:POCKET_ROUND_TAPERED ;
    cg:appliesToPattern "POCKET_*" ;
    cg:condition """GRAPH <{FACTS}> { ?rel cg:pocketClearance ?v_pocketClearance }
BIND(IF(?v_pocketClearance >= ?t_pocket_gap, cg:PASS, cg:FAIL) AS ?outcome)
""" ;
    cg:publishesValue "pocketClearance" ;
    cg:relationType cg:POCKET_CLEARANCE ;
    cg:scope "pair" ;
    cg:statement "Keep the side-wall clearance between two pockets at or above t_pocket_gap." ;
    cg:usesRelation cg:POCKET_CLEARANCE ;
    cg:usesThreshold cg:t_pocket_gap .

cg:H16 a cg:Heuristic ;
    rdfs:label "Minimum slot-to-slot clearance" ;
    cg:affectsKpi cg:kpi_collision_indicator,
        cg:kpi_workpiece_stiffness ;
    cg:appliesTo nx:SLOT_90_DEGREE,
        nx:SLOT_DOVE_TAIL,
        nx:SLOT_OBROUND,
        nx:SLOT_PARTIAL_OBROUND,
        nx:SLOT_PARTIAL_RECTANGULAR,
        nx:SLOT_PARTIAL_ROUND,
        nx:SLOT_PARTIAL_U_SHAPED,
        nx:SLOT_RECTANGULAR,
        nx:SLOT_ROUND,
        nx:SLOT_T_SHAPED,
        nx:SLOT_UPSIDE_DOWN_DOVE_TAIL,
        nx:SLOT_U_SHAPED,
        nx:SLOT_V_SHAPED ;
    cg:appliesToPattern "SLOT_*" ;
    cg:condition """GRAPH <{FACTS}> { ?rel cg:slotClearance ?v_slotClearance }
BIND(IF(?v_slotClearance >= ?t_slot_gap, cg:PASS, cg:FAIL) AS ?outcome)
""" ;
    cg:publishesValue "slotClearance" ;
    cg:relationType cg:SLOT_CLEARANCE ;
    cg:scope "pair" ;
    cg:statement "Keep the opening clearance between two slots at or above t_slot_gap." ;
    cg:usesRelation cg:SLOT_CLEARANCE ;
    cg:usesThreshold cg:t_slot_gap .

cg:H17 a cg:Heuristic ;
    rdfs:label "Minimum slot width" ;
    cg:affectsKpi cg:kpi_tool_changes ;
    cg:appliesTo nx:SLOT_90_DEGREE,
        nx:SLOT_OBROUND,
        nx:SLOT_PARTIAL_OBROUND,
        nx:SLOT_PARTIAL_RECTANGULAR,
        nx:SLOT_PARTIAL_ROUND,
        nx:SLOT_PARTIAL_U_SHAPED,
        nx:SLOT_RECTANGULAR,
        nx:SLOT_UPSIDE_DOWN_DOVE_TAIL,
        nx:SLOT_V_SHAPED ;
    cg:appliesToPattern "SLOT_90_DEGREE",
        "SLOT_OBROUND",
        "SLOT_PARTIAL_OBROUND",
        "SLOT_PARTIAL_RECTANGULAR",
        "SLOT_PARTIAL_ROUND",
        "SLOT_PARTIAL_U_SHAPED",
        "SLOT_RECTANGULAR",
        "SLOT_UPSIDE_DOWN_DOVE_TAIL",
        "SLOT_V_SHAPED" ;
    cg:condition """GRAPH <{FACTS}> { ?f nx:WIDTH ?v_WIDTH }
BIND(IF(?v_WIDTH >= ?t_slot_width, cg:PASS, cg:FAIL) AS ?outcome)
""" ;
    cg:publishesValue "WIDTH" ;
    cg:requires [ cg:attribute nx:WIDTH ;
            cg:onClass nx:SLOT_90_DEGREE ],
        [ cg:attribute nx:WIDTH ;
            cg:onClass nx:SLOT_OBROUND ],
        [ cg:attribute nx:WIDTH ;
            cg:onClass nx:SLOT_PARTIAL_OBROUND ],
        [ cg:attribute nx:WIDTH ;
            cg:onClass nx:SLOT_PARTIAL_RECTANGULAR ],
        [ cg:attribute nx:WIDTH ;
            cg:onClass nx:SLOT_PARTIAL_ROUND ],
        [ cg:attribute nx:WIDTH ;
            cg:onClass nx:SLOT_PARTIAL_U_SHAPED ],
        [ cg:attribute nx:WIDTH ;
            cg:onClass nx:SLOT_RECTANGULAR ],
        [ cg:attribute nx:WIDTH ;
            cg:onClass nx:SLOT_UPSIDE_DOWN_DOVE_TAIL ],
        [ cg:attribute nx:WIDTH ;
            cg:onClass nx:SLOT_V_SHAPED ] ;
    cg:scope "feature" ;
    cg:statement "Keep the width of a slot at or above t_slot_width." ;
    cg:usesAttributePattern "WIDTH" ;
    cg:usesThreshold cg:t_slot_width .

cg:H18 a cg:Heuristic ;
    rdfs:label "Common base-hole diameter for nearby holes" ;
    cg:affectsKpi cg:kpi_tool_changes ;
    cg:appliesTo nx:STEP1HOLE,
        nx:STEP1HOLE_THREAD,
        nx:STEP1POCKET,
        nx:STEP1POCKET_THREAD,
        nx:STEP2HOLE,
        nx:STEP2HOLE_THREAD,
        nx:STEP2POCKET,
        nx:STEP2POCKET_THREAD,
        nx:STEP3HOLE,
        nx:STEP3HOLE1,
        nx:STEP3HOLE1_THREAD,
        nx:STEP3HOLE_THREAD,
        nx:STEP3POCKET,
        nx:STEP3POCKET_THREAD,
        nx:STEP4HOLE,
        nx:STEP4HOLE1,
        nx:STEP4HOLE1_THREAD,
        nx:STEP4HOLE_THREAD,
        nx:STEP4POCKET,
        nx:STEP4POCKET_THREAD,
        nx:STEP5HOLE,
        nx:STEP5HOLE1,
        nx:STEP5HOLE1_THREAD,
        nx:STEP5HOLE2,
        nx:STEP5HOLE2_THREAD,
        nx:STEP5HOLE_THREAD,
        nx:STEP5POCKET,
        nx:STEP5POCKET_THREAD,
        nx:STEP6HOLE,
        nx:STEP6HOLE1,
        nx:STEP6HOLE1_THREAD,
        nx:STEP6HOLE2,
        nx:STEP6HOLE2_THREAD,
        nx:STEP6HOLE_THREAD,
        nx:STEP6POCKET,
        nx:STEP6POCKET_THREAD ;
    cg:appliesToPattern "STEP*" ;
    cg:condition """GRAPH <{ONTOLOGY}> { ?clsA cg:baseDiameterAttribute ?dpA . ?clsB cg:baseDiameterAttribute ?dpB }
GRAPH <{FACTS}> { ?rel cg:axisSpacing ?v_axisSpacing . ?a ?dpA ?v_baseDiameterA . ?b ?dpB ?v_baseDiameterB }
BIND(?t_hole_near * IF(?v_baseDiameterA > ?v_baseDiameterB, ?v_baseDiameterA, ?v_baseDiameterB) AS ?v_nearGate)
FILTER(?v_axisSpacing <= ?v_nearGate)
BIND(ABS(?v_baseDiameterA - ?v_baseDiameterB) AS ?v_diameterDifference)
BIND(IF(?v_diameterDifference <= ?tol_diameter, cg:PASS, cg:FAIL) AS ?outcome)
""" ;
    cg:publishesValue "axisSpacing",
        "baseDiameterA",
        "baseDiameterB",
        "diameterDifference",
        "nearGate" ;
    cg:relationType cg:HOLE_SPACING ;
    cg:requires [ cg:attribute nx:DIAMETER_1 ;
            cg:onClass nx:STEP1HOLE ],
        [ cg:attribute nx:DIAMETER_1 ;
            cg:onClass nx:STEP1HOLE_THREAD ],
        [ cg:attribute nx:DIAMETER_1 ;
            cg:onClass nx:STEP1POCKET ],
        [ cg:attribute nx:DIAMETER_1 ;
            cg:onClass nx:STEP1POCKET_THREAD ],
        [ cg:attribute nx:DIAMETER_2 ;
            cg:onClass nx:STEP2HOLE ],
        [ cg:attribute nx:DIAMETER_2 ;
            cg:onClass nx:STEP2HOLE_THREAD ],
        [ cg:attribute nx:DIAMETER_2 ;
            cg:onClass nx:STEP2POCKET ],
        [ cg:attribute nx:DIAMETER_2 ;
            cg:onClass nx:STEP2POCKET_THREAD ],
        [ cg:attribute nx:DIAMETER_3 ;
            cg:onClass nx:STEP3HOLE ],
        [ cg:attribute nx:DIAMETER_3 ;
            cg:onClass nx:STEP3HOLE1 ],
        [ cg:attribute nx:DIAMETER_3 ;
            cg:onClass nx:STEP3HOLE1_THREAD ],
        [ cg:attribute nx:DIAMETER_3 ;
            cg:onClass nx:STEP3HOLE_THREAD ],
        [ cg:attribute nx:DIAMETER_3 ;
            cg:onClass nx:STEP3POCKET ],
        [ cg:attribute nx:DIAMETER_3 ;
            cg:onClass nx:STEP3POCKET_THREAD ],
        [ cg:attribute nx:DIAMETER_4 ;
            cg:onClass nx:STEP4HOLE ],
        [ cg:attribute nx:DIAMETER_4 ;
            cg:onClass nx:STEP4HOLE1 ],
        [ cg:attribute nx:DIAMETER_4 ;
            cg:onClass nx:STEP4HOLE1_THREAD ],
        [ cg:attribute nx:DIAMETER_4 ;
            cg:onClass nx:STEP4HOLE_THREAD ],
        [ cg:attribute nx:DIAMETER_4 ;
            cg:onClass nx:STEP4POCKET ],
        [ cg:attribute nx:DIAMETER_4 ;
            cg:onClass nx:STEP4POCKET_THREAD ],
        [ cg:attribute nx:DIAMETER_5 ;
            cg:onClass nx:STEP5HOLE ],
        [ cg:attribute nx:DIAMETER_5 ;
            cg:onClass nx:STEP5HOLE1 ],
        [ cg:attribute nx:DIAMETER_5 ;
            cg:onClass nx:STEP5HOLE1_THREAD ],
        [ cg:attribute nx:DIAMETER_5 ;
            cg:onClass nx:STEP5HOLE2 ],
        [ cg:attribute nx:DIAMETER_5 ;
            cg:onClass nx:STEP5HOLE2_THREAD ],
        [ cg:attribute nx:DIAMETER_5 ;
            cg:onClass nx:STEP5HOLE_THREAD ],
        [ cg:attribute nx:DIAMETER_5 ;
            cg:onClass nx:STEP5POCKET ],
        [ cg:attribute nx:DIAMETER_5 ;
            cg:onClass nx:STEP5POCKET_THREAD ],
        [ cg:attribute nx:DIAMETER_6 ;
            cg:onClass nx:STEP6HOLE ],
        [ cg:attribute nx:DIAMETER_6 ;
            cg:onClass nx:STEP6HOLE1 ],
        [ cg:attribute nx:DIAMETER_6 ;
            cg:onClass nx:STEP6HOLE1_THREAD ],
        [ cg:attribute nx:DIAMETER_6 ;
            cg:onClass nx:STEP6HOLE2 ],
        [ cg:attribute nx:DIAMETER_6 ;
            cg:onClass nx:STEP6HOLE2_THREAD ],
        [ cg:attribute nx:DIAMETER_6 ;
            cg:onClass nx:STEP6HOLE_THREAD ],
        [ cg:attribute nx:DIAMETER_6 ;
            cg:onClass nx:STEP6POCKET ],
        [ cg:attribute nx:DIAMETER_6 ;
            cg:onClass nx:STEP6POCKET_THREAD ] ;
    cg:scope "pair" ;
    cg:statement "Two holes whose axis spacing is at most t_hole_near times the larger base-hole diameter share one base-hole diameter within tol_diameter." ;
    cg:usesAttributePattern "DIAMETER_n" ;
    cg:usesRelation cg:HOLE_SPACING ;
    cg:usesThreshold cg:t_hole_near,
        cg:tol_diameter .

cg:H19 a cg:Heuristic ;
    rdfs:label "Pocket corner-radius-to-depth ratio" ;
    cg:affectsKpi cg:kpi_machining_time,
        cg:kpi_tool_wear_proxy ;
    cg:appliesTo nx:POCKET_CLOSED,
        nx:POCKET_FREE_SHAPED_STRAIGHT,
        nx:POCKET_OPEN ;
    cg:appliesToPattern "POCKET_CLOSED",
        "POCKET_FREE_SHAPED_STRAIGHT",
        "POCKET_OPEN" ;
    cg:condition """GRAPH <{FACTS}> { ?f nx:MIN_RADIUS ?v_MIN_RADIUS ; nx:DEPTH ?v_DEPTH }
FILTER(?v_DEPTH > 0)
BIND(?v_MIN_RADIUS / ?v_DEPTH AS ?v_cornerRadiusToDepth)
BIND(IF(?v_cornerRadiusToDepth >= ?t_corner_depth_ratio, cg:PASS, cg:FAIL) AS ?outcome)
""" ;
    cg:publishesValue "DEPTH",
        "MIN_RADIUS",
        "cornerRadiusToDepth" ;
    cg:requires [ cg:attribute nx:DEPTH,
                nx:MIN_RADIUS ;
            cg:onClass nx:POCKET_CLOSED ],
        [ cg:attribute nx:DEPTH,
                nx:MIN_RADIUS ;
            cg:onClass nx:POCKET_FREE_SHAPED_STRAIGHT ],
        [ cg:attribute nx:DEPTH,
                nx:MIN_RADIUS ;
            cg:onClass nx:POCKET_OPEN ] ;
    cg:scope "feature" ;
    cg:statement "Keep the minimum concave internal corner radius of a pocket at or above t_corner_depth_ratio times its depth." ;
    cg:usesAttributePattern "DEPTH",
        "MIN_RADIUS" ;
    cg:usesThreshold cg:t_corner_depth_ratio .

cg:H21 a cg:Heuristic ;
    rdfs:label "Vertical pocket walls" ;
    cg:affectsKpi cg:kpi_machining_time ;
    cg:appliesTo nx:POCKET_CLOSED,
        nx:POCKET_OPEN ;
    cg:appliesToPattern "POCKET_CLOSED",
        "POCKET_OPEN" ;
    cg:condition """GRAPH <{FACTS}> { ?f nx:MIN_SIDE_ANGLE ?v_MIN_SIDE_ANGLE }
BIND(90 - ?v_MIN_SIDE_ANGLE AS ?v_draftFromVertical)
BIND(IF(?v_draftFromVertical <= ?tol_draft_zero, cg:PASS, cg:FAIL) AS ?outcome)
""" ;
    cg:publishesValue "MIN_SIDE_ANGLE",
        "draftFromVertical" ;
    cg:requires [ cg:attribute nx:MIN_SIDE_ANGLE ;
            cg:onClass nx:POCKET_CLOSED ],
        [ cg:attribute nx:MIN_SIDE_ANGLE ;
            cg:onClass nx:POCKET_OPEN ] ;
    cg:scope "feature" ;
    cg:statement "Keep the deviation of the pocket walls from vertical at or below tol_draft_zero." ;
    cg:usesAttributePattern "MIN_SIDE_ANGLE" ;
    cg:usesThreshold cg:tol_draft_zero .

cg:H22 a cg:Heuristic ;
    rdfs:label "Entry blind hole for a deep pocket" ;
    cg:affectsKpi cg:kpi_machining_time,
        cg:kpi_tool_changes ;
    cg:appliesTo nx:POCKET_CLOSED,
        nx:POCKET_FREE_SHAPED_STRAIGHT,
        nx:POCKET_OBROUND_CURVED_STRAIGHT,
        nx:POCKET_OBROUND_STRAIGHT,
        nx:POCKET_OPEN,
        nx:POCKET_RECTANGULAR_STRAIGHT,
        nx:POCKET_ROUND_TAPERED ;
    cg:appliesToPattern "POCKET_*" ;
    cg:condition """GRAPH <{FACTS}> { ?f nx:DEPTH ?v_DEPTH }
FILTER(?v_DEPTH >= ?t_pocket_entry_depth)
{ SELECT ?f (COUNT(DISTINCT ?h) AS ?v_entryHoleCount) WHERE {
    GRAPH <{FACTS}> { ?f a ?c }
    OPTIONAL {
      GRAPH <{FACTS}> { ?loc cg:relationType cg:LOCATED_ON ; cg:terminal ?t .
                        ?t cg:hostOwner ?f ; cg:terminalFeature ?h . ?h a ?hcls }
      GRAPH <{ONTOLOGY}> { ?hcls rdfs:subClassOf* nx:STEP ; cg:blind true }
    }
  } GROUP BY ?f }
BIND(IF(?v_entryHoleCount > 0, cg:PASS, cg:FAIL) AS ?outcome)
""" ;
    cg:publishesValue "DEPTH",
        "entryHoleCount" ;
    cg:requires [ cg:attribute nx:DEPTH ;
            cg:onClass nx:POCKET_CLOSED ],
        [ cg:attribute nx:DEPTH ;
            cg:onClass nx:POCKET_FREE_SHAPED_STRAIGHT ],
        [ cg:attribute nx:DEPTH ;
            cg:onClass nx:POCKET_OBROUND_CURVED_STRAIGHT ],
        [ cg:attribute nx:DEPTH ;
            cg:onClass nx:POCKET_OBROUND_STRAIGHT ],
        [ cg:attribute nx:DEPTH ;
            cg:onClass nx:POCKET_OPEN ],
        [ cg:attribute nx:DEPTH ;
            cg:onClass nx:POCKET_RECTANGULAR_STRAIGHT ],
        [ cg:attribute nx:DEPTH ;
            cg:onClass nx:POCKET_ROUND_TAPERED ] ;
    cg:scope "feature" ;
    cg:statement "A pocket at least t_pocket_entry_depth deep has a blind hole located on it as a plunge entry." ;
    cg:usesAttributePattern "DEPTH" ;
    cg:usesRelation cg:LOCATED_ON ;
    cg:usesThreshold cg:t_pocket_entry_depth .

cg:H23 a cg:Heuristic ;
    rdfs:label "Slot depth-to-width ratio" ;
    cg:affectsKpi cg:kpi_machining_time,
        cg:kpi_tool_wear_proxy ;
    cg:appliesTo nx:SLOT_90_DEGREE,
        nx:SLOT_OBROUND,
        nx:SLOT_PARTIAL_OBROUND,
        nx:SLOT_PARTIAL_RECTANGULAR,
        nx:SLOT_PARTIAL_ROUND,
        nx:SLOT_PARTIAL_U_SHAPED,
        nx:SLOT_RECTANGULAR,
        nx:SLOT_UPSIDE_DOWN_DOVE_TAIL,
        nx:SLOT_V_SHAPED ;
    cg:appliesToPattern "SLOT_90_DEGREE",
        "SLOT_OBROUND",
        "SLOT_PARTIAL_OBROUND",
        "SLOT_PARTIAL_RECTANGULAR",
        "SLOT_PARTIAL_ROUND",
        "SLOT_PARTIAL_U_SHAPED",
        "SLOT_RECTANGULAR",
        "SLOT_UPSIDE_DOWN_DOVE_TAIL",
        "SLOT_V_SHAPED" ;
    cg:condition """GRAPH <{FACTS}> { ?f nx:DEPTH ?v_DEPTH ; nx:WIDTH ?v_WIDTH }
FILTER(?v_WIDTH > 0)
BIND(?v_DEPTH / ?v_WIDTH AS ?v_depthToWidth)
BIND(IF(?v_depthToWidth <= ?t_slot_ld, cg:PASS, cg:FAIL) AS ?outcome)
""" ;
    cg:publishesValue "DEPTH",
        "WIDTH",
        "depthToWidth" ;
    cg:requires [ cg:attribute nx:DEPTH,
                nx:WIDTH ;
            cg:onClass nx:SLOT_90_DEGREE ],
        [ cg:attribute nx:DEPTH,
                nx:WIDTH ;
            cg:onClass nx:SLOT_OBROUND ],
        [ cg:attribute nx:DEPTH,
                nx:WIDTH ;
            cg:onClass nx:SLOT_PARTIAL_OBROUND ],
        [ cg:attribute nx:DEPTH,
                nx:WIDTH ;
            cg:onClass nx:SLOT_PARTIAL_RECTANGULAR ],
        [ cg:attribute nx:DEPTH,
                nx:WIDTH ;
            cg:onClass nx:SLOT_PARTIAL_ROUND ],
        [ cg:attribute nx:DEPTH,
                nx:WIDTH ;
            cg:onClass nx:SLOT_PARTIAL_U_SHAPED ],
        [ cg:attribute nx:DEPTH,
                nx:WIDTH ;
            cg:onClass nx:SLOT_RECTANGULAR ],
        [ cg:attribute nx:DEPTH,
                nx:WIDTH ;
            cg:onClass nx:SLOT_UPSIDE_DOWN_DOVE_TAIL ],
        [ cg:attribute nx:DEPTH,
                nx:WIDTH ;
            cg:onClass nx:SLOT_V_SHAPED ] ;
    cg:scope "feature" ;
    cg:statement "Keep the depth of a slot at or below t_slot_ld times its width." ;
    cg:usesAttributePattern "DEPTH",
        "WIDTH" ;
    cg:usesThreshold cg:t_slot_ld .

cg:H28 a cg:Heuristic ;
    rdfs:label "Minimum blind-hole floor thickness" ;
    cg:affectsKpi cg:kpi_workpiece_stiffness ;
    cg:appliesTo nx:STEP1POCKET,
        nx:STEP2POCKET,
        nx:STEP3POCKET,
        nx:STEP4POCKET,
        nx:STEP5POCKET,
        nx:STEP6POCKET ;
    cg:appliesToPattern "STEP*POCKET" ;
    cg:condition """GRAPH <{FACTS}> { ?f cg:derived_floor_thickness ?v_derived_floor_thickness }
BIND(IF(?v_derived_floor_thickness >= ?t_floor, cg:PASS, cg:FAIL) AS ?outcome)
""" ;
    cg:publishesValue "derived_floor_thickness" ;
    cg:requires [ cg:attribute cg:derived_floor_thickness ;
            cg:onClass nx:STEP1POCKET ],
        [ cg:attribute cg:derived_floor_thickness ;
            cg:onClass nx:STEP2POCKET ],
        [ cg:attribute cg:derived_floor_thickness ;
            cg:onClass nx:STEP3POCKET ],
        [ cg:attribute cg:derived_floor_thickness ;
            cg:onClass nx:STEP4POCKET ],
        [ cg:attribute cg:derived_floor_thickness ;
            cg:onClass nx:STEP5POCKET ],
        [ cg:attribute cg:derived_floor_thickness ;
            cg:onClass nx:STEP6POCKET ] ;
    cg:scope "feature" ;
    cg:statement "Keep the remaining material below the bottom of a blind hole at or above t_floor." ;
    cg:usesAttributePattern "derived_floor_thickness" ;
    cg:usesThreshold cg:t_floor .

cg:H37 a cg:Heuristic ;
    rdfs:label "Minimum clearance around a boss" ;
    cg:affectsKpi cg:kpi_collision_indicator,
        cg:kpi_machining_time ;
    cg:appliesTo nx:BOSS_RECTANGULAR_STRAIGHT,
        nx:BOSS_ROUND_STRAIGHT,
        nx:BOSS_ROUND_STRAIGHT_THREAD ;
    cg:appliesToPattern "BOSS_*" ;
    cg:condition """GRAPH <{FACTS}> { ?f cg:derived_min_clearance ?v_derived_min_clearance }
BIND(IF(?v_derived_min_clearance >= ?t_boss_clearance, cg:PASS, cg:FAIL) AS ?outcome)
""" ;
    cg:publishesValue "derived_min_clearance" ;
    cg:requires [ cg:attribute cg:derived_min_clearance ;
            cg:onClass nx:BOSS_RECTANGULAR_STRAIGHT ],
        [ cg:attribute cg:derived_min_clearance ;
            cg:onClass nx:BOSS_ROUND_STRAIGHT ],
        [ cg:attribute cg:derived_min_clearance ;
            cg:onClass nx:BOSS_ROUND_STRAIGHT_THREAD ] ;
    cg:scope "feature" ;
    cg:statement "Keep the free space around a boss at or above t_boss_clearance." ;
    cg:usesAttributePattern "derived_min_clearance" ;
    cg:usesThreshold cg:t_boss_clearance .

cg:H38 a cg:Heuristic ;
    rdfs:label "Rectangular-boss slenderness ratio" ;
    cg:affectsKpi cg:kpi_tool_wear_proxy,
        cg:kpi_workpiece_stiffness ;
    cg:appliesTo nx:BOSS_RECTANGULAR_STRAIGHT ;
    cg:appliesToPattern "BOSS_RECTANGULAR_STRAIGHT" ;
    cg:condition """GRAPH <{FACTS}> { ?f nx:DEPTH ?v_DEPTH ; nx:WIDTH ?v_WIDTH ; nx:LENGTH ?v_LENGTH }
BIND(IF(?v_WIDTH < ?v_LENGTH, ?v_WIDTH, ?v_LENGTH) AS ?v_minThickness)
FILTER(?v_minThickness > 0)
BIND(?v_DEPTH / ?v_minThickness AS ?v_heightToMinThickness)
BIND(IF(?v_heightToMinThickness <= ?t_boss_slenderness, cg:PASS, cg:FAIL) AS ?outcome)
""" ;
    cg:publishesValue "DEPTH",
        "LENGTH",
        "WIDTH",
        "heightToMinThickness",
        "minThickness" ;
    cg:requires [ cg:attribute nx:DEPTH,
                nx:LENGTH,
                nx:WIDTH ;
            cg:onClass nx:BOSS_RECTANGULAR_STRAIGHT ] ;
    cg:scope "feature" ;
    cg:statement "Keep the height of a rectangular boss at or below t_boss_slenderness times the smaller of its width and length." ;
    cg:usesAttributePattern "DEPTH",
        "LENGTH",
        "WIDTH" ;
    cg:usesThreshold cg:t_boss_slenderness .

cg:H43 a cg:Heuristic ;
    rdfs:label "Minimum through-cut corner radius" ;
    cg:affectsKpi cg:kpi_machining_time,
        cg:kpi_tool_changes ;
    cg:appliesTo nx:HOLE_FREE_SHAPED_STRAIGHT ;
    cg:appliesToPattern "HOLE_FREE_SHAPED_STRAIGHT" ;
    cg:condition """GRAPH <{FACTS}> { ?f nx:MIN_RADIUS ?v_MIN_RADIUS }
BIND(IF(?v_MIN_RADIUS >= ?t_throughcut_corner_radius, cg:PASS, cg:FAIL) AS ?outcome)
""" ;
    cg:publishesValue "MIN_RADIUS" ;
    cg:requires [ cg:attribute nx:MIN_RADIUS ;
            cg:onClass nx:HOLE_FREE_SHAPED_STRAIGHT ] ;
    cg:scope "feature" ;
    cg:statement "Keep the minimum concave internal corner radius of a through cut at or above t_throughcut_corner_radius." ;
    cg:usesAttributePattern "MIN_RADIUS" ;
    cg:usesThreshold cg:t_throughcut_corner_radius .

cg:H46 a cg:Heuristic ;
    rdfs:label "Minimum intersecting-hole angle" ;
    cg:affectsKpi cg:kpi_rest_material_indicator,
        cg:kpi_tool_wear_proxy ;
    cg:appliesTo nx:STEP1HOLE,
        nx:STEP1HOLE_THREAD,
        nx:STEP1POCKET,
        nx:STEP1POCKET_THREAD,
        nx:STEP2HOLE,
        nx:STEP2HOLE_THREAD,
        nx:STEP2POCKET,
        nx:STEP2POCKET_THREAD,
        nx:STEP3HOLE,
        nx:STEP3HOLE1,
        nx:STEP3HOLE1_THREAD,
        nx:STEP3HOLE_THREAD,
        nx:STEP3POCKET,
        nx:STEP3POCKET_THREAD,
        nx:STEP4HOLE,
        nx:STEP4HOLE1,
        nx:STEP4HOLE1_THREAD,
        nx:STEP4HOLE_THREAD,
        nx:STEP4POCKET,
        nx:STEP4POCKET_THREAD,
        nx:STEP5HOLE,
        nx:STEP5HOLE1,
        nx:STEP5HOLE1_THREAD,
        nx:STEP5HOLE2,
        nx:STEP5HOLE2_THREAD,
        nx:STEP5HOLE_THREAD,
        nx:STEP5POCKET,
        nx:STEP5POCKET_THREAD,
        nx:STEP6HOLE,
        nx:STEP6HOLE1,
        nx:STEP6HOLE1_THREAD,
        nx:STEP6HOLE2,
        nx:STEP6HOLE2_THREAD,
        nx:STEP6HOLE_THREAD,
        nx:STEP6POCKET,
        nx:STEP6POCKET_THREAD ;
    cg:appliesToPattern "STEP*" ;
    cg:condition """GRAPH <{FACTS}> { ?rel cg:crossingAngle ?v_crossingAngle }
BIND(IF(?v_crossingAngle >= ?t_crossing_angle, cg:PASS, cg:FAIL) AS ?outcome)
""" ;
    cg:publishesValue "crossingAngle" ;
    cg:relationType cg:INTERSECTS ;
    cg:scope "pair" ;
    cg:statement "Keep the crossing angle between two intersecting holes at or above t_crossing_angle." ;
    cg:usesRelation cg:INTERSECTS ;
    cg:usesThreshold cg:t_crossing_angle .

cg:H51 a cg:Heuristic ;
    rdfs:label "Minimum remaining wall thickness" ;
    cg:affectsKpi cg:kpi_workpiece_stiffness ;
    cg:appliesTo nx:HOLE_FREE_SHAPED_STRAIGHT,
        nx:HOLE_OBROUND_CURVED_STRAIGHT,
        nx:HOLE_OBROUND_STRAIGHT,
        nx:HOLE_RECTANGULAR_STRAIGHT,
        nx:HOLE_ROUND_INTERRUPTED_STRAIGHT,
        nx:HOLE_ROUND_TAPERED,
        nx:POCKET_CLOSED,
        nx:POCKET_FREE_SHAPED_STRAIGHT,
        nx:POCKET_OBROUND_CURVED_STRAIGHT,
        nx:POCKET_OBROUND_STRAIGHT,
        nx:POCKET_OPEN,
        nx:POCKET_RECTANGULAR_STRAIGHT,
        nx:POCKET_ROUND_TAPERED,
        nx:SLOT_90_DEGREE,
        nx:SLOT_DOVE_TAIL,
        nx:SLOT_OBROUND,
        nx:SLOT_PARTIAL_OBROUND,
        nx:SLOT_PARTIAL_RECTANGULAR,
        nx:SLOT_PARTIAL_ROUND,
        nx:SLOT_PARTIAL_U_SHAPED,
        nx:SLOT_RECTANGULAR,
        nx:SLOT_ROUND,
        nx:SLOT_T_SHAPED,
        nx:SLOT_UPSIDE_DOWN_DOVE_TAIL,
        nx:SLOT_U_SHAPED,
        nx:SLOT_V_SHAPED,
        nx:STEP1HOLE,
        nx:STEP1HOLE_THREAD,
        nx:STEP1POCKET,
        nx:STEP1POCKET_THREAD,
        nx:STEP2HOLE,
        nx:STEP2HOLE_THREAD,
        nx:STEP2POCKET,
        nx:STEP2POCKET_THREAD,
        nx:STEP3HOLE,
        nx:STEP3HOLE1,
        nx:STEP3HOLE1_THREAD,
        nx:STEP3HOLE_THREAD,
        nx:STEP3POCKET,
        nx:STEP3POCKET_THREAD,
        nx:STEP4HOLE,
        nx:STEP4HOLE1,
        nx:STEP4HOLE1_THREAD,
        nx:STEP4HOLE_THREAD,
        nx:STEP4POCKET,
        nx:STEP4POCKET_THREAD,
        nx:STEP5HOLE,
        nx:STEP5HOLE1,
        nx:STEP5HOLE1_THREAD,
        nx:STEP5HOLE2,
        nx:STEP5HOLE2_THREAD,
        nx:STEP5HOLE_THREAD,
        nx:STEP5POCKET,
        nx:STEP5POCKET_THREAD,
        nx:STEP6HOLE,
        nx:STEP6HOLE1,
        nx:STEP6HOLE1_THREAD,
        nx:STEP6HOLE2,
        nx:STEP6HOLE2_THREAD,
        nx:STEP6HOLE_THREAD,
        nx:STEP6POCKET,
        nx:STEP6POCKET_THREAD ;
    cg:appliesToPattern "HOLE_*",
        "POCKET_*",
        "SLOT_*",
        "STEP*" ;
    cg:condition """GRAPH <{FACTS}> { ?f cg:derived_min_wall_thickness ?v_derived_min_wall_thickness }
BIND(IF(?v_derived_min_wall_thickness >= ?t_min_wall, cg:PASS, cg:FAIL) AS ?outcome)
""" ;
    cg:publishesValue "derived_min_wall_thickness" ;
    cg:requires [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:HOLE_FREE_SHAPED_STRAIGHT ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:HOLE_OBROUND_CURVED_STRAIGHT ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:HOLE_OBROUND_STRAIGHT ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:HOLE_RECTANGULAR_STRAIGHT ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:HOLE_ROUND_INTERRUPTED_STRAIGHT ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:HOLE_ROUND_TAPERED ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:POCKET_CLOSED ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:POCKET_FREE_SHAPED_STRAIGHT ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:POCKET_OBROUND_CURVED_STRAIGHT ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:POCKET_OBROUND_STRAIGHT ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:POCKET_OPEN ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:POCKET_RECTANGULAR_STRAIGHT ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:POCKET_ROUND_TAPERED ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:SLOT_90_DEGREE ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:SLOT_DOVE_TAIL ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:SLOT_OBROUND ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:SLOT_PARTIAL_OBROUND ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:SLOT_PARTIAL_RECTANGULAR ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:SLOT_PARTIAL_ROUND ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:SLOT_PARTIAL_U_SHAPED ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:SLOT_RECTANGULAR ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:SLOT_ROUND ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:SLOT_T_SHAPED ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:SLOT_UPSIDE_DOWN_DOVE_TAIL ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:SLOT_U_SHAPED ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:SLOT_V_SHAPED ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP1HOLE ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP1HOLE_THREAD ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP1POCKET ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP1POCKET_THREAD ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP2HOLE ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP2HOLE_THREAD ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP2POCKET ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP2POCKET_THREAD ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP3HOLE ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP3HOLE1 ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP3HOLE1_THREAD ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP3HOLE_THREAD ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP3POCKET ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP3POCKET_THREAD ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP4HOLE ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP4HOLE1 ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP4HOLE1_THREAD ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP4HOLE_THREAD ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP4POCKET ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP4POCKET_THREAD ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP5HOLE ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP5HOLE1 ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP5HOLE1_THREAD ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP5HOLE2 ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP5HOLE2_THREAD ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP5HOLE_THREAD ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP5POCKET ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP5POCKET_THREAD ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP6HOLE ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP6HOLE1 ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP6HOLE1_THREAD ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP6HOLE2 ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP6HOLE2_THREAD ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP6HOLE_THREAD ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP6POCKET ],
        [ cg:attribute cg:derived_min_wall_thickness ;
            cg:onClass nx:STEP6POCKET_THREAD ] ;
    cg:scope "feature" ;
    cg:statement "Keep the remaining wall thickness around a removal feature at or above t_min_wall." ;
    cg:usesAttributePattern "derived_min_wall_thickness" ;
    cg:usesThreshold cg:t_min_wall .

cg:H53 a cg:Heuristic ;
    rdfs:label "Standard V-slot tool angle" ;
    cg:affectsKpi cg:kpi_tool_changes ;
    cg:appliesTo nx:SLOT_DOVE_TAIL,
        nx:SLOT_UPSIDE_DOWN_DOVE_TAIL,
        nx:SLOT_V_SHAPED ;
    cg:appliesToPattern "SLOT_DOVE_TAIL",
        "SLOT_UPSIDE_DOWN_DOVE_TAIL",
        "SLOT_V_SHAPED" ;
    cg:condition """GRAPH <{FACTS}> { ?f nx:ANGLE ?v_ANGLE }
OPTIONAL {
  SELECT ?f (COUNT(?m) AS ?matches) WHERE {
    GRAPH <{FACTS}> { ?f nx:ANGLE ?ang }
    GRAPH <{ONTOLOGY}> { cg:T_v_tool_angles cg:member ?m . cg:tol_angle cg:value ?tol }
    FILTER(ABS(?ang - ?m) <= ?tol)
  } GROUP BY ?f
}
BIND(COALESCE(?matches, 0) AS ?v_matchingStandardAngles)
BIND(IF(?v_matchingStandardAngles > 0, cg:PASS, cg:FAIL) AS ?outcome)
""" ;
    cg:publishesValue "ANGLE",
        "matchingStandardAngles" ;
    cg:requires [ cg:attribute nx:ANGLE ;
            cg:onClass nx:SLOT_DOVE_TAIL ],
        [ cg:attribute nx:ANGLE ;
            cg:onClass nx:SLOT_UPSIDE_DOWN_DOVE_TAIL ],
        [ cg:attribute nx:ANGLE ;
            cg:onClass nx:SLOT_V_SHAPED ] ;
    cg:scope "feature" ;
    cg:statement "Use a V-slot included angle that is one of T_v_tool_angles within tol_angle." ;
    cg:usesAttributePattern "ANGLE" ;
    cg:usesThreshold cg:T_v_tool_angles,
        cg:tol_angle .

cg:KPIResult a owl:Class ;
    rdfs:label "KPIResult" ;
    skos:definition "One value of one KPI type for one feature or one run." .

cg:Measurement a owl:Class ;
    rdfs:label "Measurement" ;
    skos:definition "One derived quantity measured by the geometry kernel, with its method and evidence." .

cg:MeasurementRefusal a owl:Class ;
    rdfs:label "MeasurementRefusal" ;
    skos:definition "A derived quantity the kernel could not measure, with the reason." .

cg:NOT_APPLICABLE a cg:Outcome ;
    rdfs:label "NOT_APPLICABLE" .

cg:NOT_EVALUABLE a cg:Outcome ;
    rdfs:label "NOT_EVALUABLE" .

cg:PASS a cg:Outcome ;
    rdfs:label "PASS" .

cg:Part a owl:Class ;
    rdfs:label "Part" ;
    skos:definition "One part, as read from one STEP file." .

cg:Value a owl:Class ;
    rdfs:label "Value" ;
    skos:definition "A named quantity computed while evaluating a rule." .

cg:Verdict a owl:Class ;
    rdfs:label "Verdict" ;
    skos:definition "The outcome of one rule on one feature or one relation." .

cg:axisSpacing a owl:DatatypeProperty ;
    rdfs:label "axisSpacing" ;
    rdfs:domain cg:FeatureRelation ;
    rdfs:range xsd:decimal ;
    skos:definition "Perpendicular distance between the two feature axes." ;
    cg:onRelationType cg:HOLE_SPACING ;
    cg:unit "mm" .

cg:crossingAngle a owl:DatatypeProperty ;
    rdfs:label "crossingAngle" ;
    rdfs:domain cg:FeatureRelation ;
    rdfs:range xsd:decimal ;
    skos:definition "Angle between the two feature axes." ;
    cg:onRelationType cg:INTERSECTS ;
    cg:unit "deg" .

cg:hostFace a owl:ObjectProperty ;
    rdfs:label "hostFace" ;
    rdfs:domain cg:LocatedOnTerminal ;
    skos:definition "The host face." .

cg:hostOwner a owl:ObjectProperty ;
    rdfs:label "hostOwner" ;
    rdfs:domain cg:LocatedOnTerminal ;
    skos:definition "The feature that owns the host face." .

cg:hostSurfaceNormal a owl:DatatypeProperty ;
    rdfs:label "hostSurfaceNormal" ;
    rdfs:domain cg:LocatedOnTerminal ;
    skos:definition "Outward normal of the host face at the opening, three components." .

cg:hostSurfaceType a owl:DatatypeProperty ;
    rdfs:label "hostSurfaceType" ;
    rdfs:domain cg:LocatedOnTerminal ;
    skos:definition "Surface type of the host face." .

cg:kpi_energy_consumption a cg:KPIType ;
    rdfs:label "energy consumption" ;
    skos:definition "Energy demand of machining from the process model." ;
    cg:kind "run" ;
    cg:unit "J" ;
    cg:worseWhen "higher" .

cg:kpi_material_removal_rate a cg:KPIType ;
    rdfs:label "material removal rate" ;
    skos:definition "Material removed per unit time." ;
    cg:kind "run" ;
    cg:unit "mm3/s" ;
    cg:worseWhen "lower" .

cg:kpi_max_permissible_tool_diameter_corner a cg:KpiDerivation ;
    rdfs:label "kpi_max_permissible_tool_diameter_corner" ;
    cg:appliesTo nx:HOLE_FREE_SHAPED_STRAIGHT,
        nx:POCKET_CLOSED,
        nx:POCKET_FREE_SHAPED_STRAIGHT,
        nx:POCKET_OPEN ;
    cg:condition """GRAPH <{FACTS}> { ?f nx:MIN_RADIUS ?r }
BIND(2 * ?r AS ?value)
""" ;
    cg:formula "2 * MIN_RADIUS" ;
    cg:kpiType cg:kpi_max_permissible_tool_diameter ;
    cg:usesAttributePattern "MIN_RADIUS" .

cg:kpi_max_permissible_tool_diameter_obround a cg:KpiDerivation ;
    rdfs:label "kpi_max_permissible_tool_diameter_obround" ;
    cg:appliesTo nx:HOLE_OBROUND_STRAIGHT,
        nx:POCKET_OBROUND_STRAIGHT ;
    cg:condition """GRAPH <{FACTS}> { ?f nx:LENGTH ?l ; nx:RADIUS ?r }
BIND(IF(?r > 0 && 2 * ?r < ?l, 2 * ?r, ?l) AS ?value)
""" ;
    cg:formula "min(LENGTH, 2 * RADIUS)" ;
    cg:kpiType cg:kpi_max_permissible_tool_diameter ;
    cg:usesAttributePattern "LENGTH",
        "RADIUS" .

cg:kpi_max_permissible_tool_diameter_rectangular a cg:KpiDerivation ;
    rdfs:label "kpi_max_permissible_tool_diameter_rectangular" ;
    cg:appliesTo nx:CORNER_NOTCH_RECTANGULAR,
        nx:HOLE_RECTANGULAR_STRAIGHT,
        nx:POCKET_RECTANGULAR_STRAIGHT,
        nx:SLOT_OBROUND,
        nx:SLOT_RECTANGULAR ;
    cg:condition """GRAPH <{FACTS}> { ?f nx:WIDTH ?w ; nx:LENGTH ?l ; nx:RADIUS ?r }
BIND(IF(?w < ?l, ?w, ?l) AS ?wl)
BIND(IF(?r > 0 && 2 * ?r < ?wl, 2 * ?r, ?wl) AS ?value)
""" ;
    cg:formula "min(WIDTH, LENGTH, 2 * RADIUS)" ;
    cg:kpiType cg:kpi_max_permissible_tool_diameter ;
    cg:usesAttributePattern "LENGTH",
        "RADIUS",
        "WIDTH" .

cg:kpi_max_permissible_tool_diameter_stepped a cg:KpiDerivation ;
    rdfs:label "kpi_max_permissible_tool_diameter_stepped" ;
    cg:appliesTo nx:STEP1HOLE,
        nx:STEP1HOLE_THREAD,
        nx:STEP1POCKET,
        nx:STEP1POCKET_THREAD,
        nx:STEP2HOLE,
        nx:STEP2HOLE_THREAD,
        nx:STEP2POCKET,
        nx:STEP2POCKET_THREAD,
        nx:STEP3HOLE,
        nx:STEP3HOLE1,
        nx:STEP3HOLE1_THREAD,
        nx:STEP3HOLE_THREAD,
        nx:STEP3POCKET,
        nx:STEP3POCKET_THREAD,
        nx:STEP4HOLE,
        nx:STEP4HOLE1,
        nx:STEP4HOLE1_THREAD,
        nx:STEP4HOLE_THREAD,
        nx:STEP4POCKET,
        nx:STEP4POCKET_THREAD,
        nx:STEP5HOLE,
        nx:STEP5HOLE1,
        nx:STEP5HOLE1_THREAD,
        nx:STEP5HOLE2,
        nx:STEP5HOLE2_THREAD,
        nx:STEP5HOLE_THREAD,
        nx:STEP5POCKET,
        nx:STEP5POCKET_THREAD,
        nx:STEP6HOLE,
        nx:STEP6HOLE1,
        nx:STEP6HOLE1_THREAD,
        nx:STEP6HOLE2,
        nx:STEP6HOLE2_THREAD,
        nx:STEP6HOLE_THREAD,
        nx:STEP6POCKET,
        nx:STEP6POCKET_THREAD ;
    cg:condition """{ SELECT ?f (MIN(?d) AS ?value) WHERE {
    GRAPH <{FACTS}> { ?f a ?c . ?f ?dp ?d }
    GRAPH <{ONTOLOGY}> { ?c cg:section ?s . ?s cg:diameterAttribute ?dp }
  } GROUP BY ?f }
""" ;
    cg:formula "min over sections k of DIAMETER_k" ;
    cg:kpiType cg:kpi_max_permissible_tool_diameter ;
    cg:usesAttributePattern "DIAMETER_k" .

cg:kpi_tool_stiffness a cg:KPIType ;
    rdfs:label "tool stiffness" ;
    skos:definition "Stiffness of the tool required for machining, depending on stickout." ;
    cg:kind "feature" ;
    cg:unit "N/um" ;
    cg:worseWhen "higher" .

cg:pocketClearance a owl:DatatypeProperty ;
    rdfs:label "pocketClearance" ;
    rdfs:domain cg:FeatureRelation ;
    rdfs:range xsd:decimal ;
    skos:definition "Shortest distance between the two side-wall face sets." ;
    cg:onRelationType cg:POCKET_CLEARANCE ;
    cg:unit "mm" .

cg:slotClearance a owl:DatatypeProperty ;
    rdfs:label "slotClearance" ;
    rdfs:domain cg:FeatureRelation ;
    rdfs:range xsd:decimal ;
    skos:definition "Shortest distance between the two opening boundaries." ;
    cg:onRelationType cg:SLOT_CLEARANCE ;
