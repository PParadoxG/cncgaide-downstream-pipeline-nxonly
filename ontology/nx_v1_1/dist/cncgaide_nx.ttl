cg:derived_min_wall_thickness a owl:DatatypeProperty ;
    rdfs:label "minimum wall thickness" ;
    rdfs:range xsd:decimal ;
    skos:definition "Thinnest remaining wall between the side walls of the feature and the nearest other surface of the part." ;
    cg:appliesTo nx:HOLE_FREE_SHAPED_STRAIGHT,
        nx:HOLE_OBROUND_CURVED_STRAIGHT,
        nx:HOLE_OBROUND_STRAIGHT,
        nx:HOLE_RECTANGULAR_STRAIGHT,
        nx:HOLE_ROUND_INTERRUPTED_STRAIGHT,
        nx:HOLE_ROUND_TAPERED,
        nx:POCKET_CLOSED,
        nx:POCKET_FREE_SHAPED_STRAIGHT,
        nx:POCKET_OBROUND_CURVED_STRAIGHT,
        nx:POCKET_OBROUND_STRAIGHT,
        nx:POCKET_OPEN,
        nx:POCKET_RECTANGULAR_STRAIGHT,
        nx:POCKET_ROUND_TAPERED,
        nx:SLOT_90_DEGREE,
        nx:SLOT_DOVE_TAIL,
        nx:SLOT_OBROUND,
        nx:SLOT_PARTIAL_OBROUND,
        nx:SLOT_PARTIAL_RECTANGULAR,
        nx:SLOT_PARTIAL_ROUND,
        nx:SLOT_PARTIAL_U_SHAPED,
        nx:SLOT_RECTANGULAR,
        nx:SLOT_ROUND,
        nx:SLOT_T_SHAPED,
        nx:SLOT_UPSIDE_DOWN_DOVE_TAIL,
        nx:SLOT_U_SHAPED,
        nx:SLOT_V_SHAPED,
        nx:STEP1HOLE,
        nx:STEP1HOLE_THREAD,
        nx:STEP1POCKET,
        nx:STEP1POCKET_THREAD,
        nx:STEP2HOLE,
        nx:STEP2HOLE_THREAD,
        nx:STEP2POCKET,
        nx:STEP2POCKET_THREAD,
        nx:STEP3HOLE,
        nx:STEP3HOLE1,
        nx:STEP3HOLE1_THREAD,
        nx:STEP3HOLE_THREAD,
        nx:STEP3POCKET,
        nx:STEP3POCKET_THREAD,
        nx:STEP4HOLE,
        nx:STEP4HOLE1,
        nx:STEP4HOLE1_THREAD,
        nx:STEP4HOLE_THREAD,
        nx:STEP4POCKET,
        nx:STEP4POCKET_THREAD,
        nx:STEP5HOLE,
        nx:STEP5HOLE1,
        nx:STEP5HOLE1_THREAD,
        nx:STEP5HOLE2,
        nx:STEP5HOLE2_THREAD,
        nx:STEP5HOLE_THREAD,
        nx:STEP5POCKET,
        nx:STEP5POCKET_THREAD,
        nx:STEP6HOLE,
        nx:STEP6HOLE1,
        nx:STEP6HOLE1_THREAD,
        nx:STEP6HOLE2,
        nx:STEP6HOLE2_THREAD,
        nx:STEP6HOLE_THREAD,
        nx:STEP6POCKET,
        nx:STEP6POCKET_THREAD ;
    cg:derivedQuantity true ;
    cg:method "ray cast from sampled side-wall normals into the material to the first other surface" ;
    cg:proxyFor cg:kpi_workpiece_stiffness ;
    cg:proxyNote "A thinner remaining wall means a lower local workpiece stiffness; the wall thickness stands in for the stiffness, which needs material data to compute." ;
    cg:unit "mm" .

