cg:AttributeGap a owl:Class ;
    rdfs:label "AttributeGap" ;
    skos:definition "An attribute NX declares on the feature and did not hand over, with NX's reason." .

cg:FAIL a cg:Outcome ;
    rdfs:label "FAIL" .

cg:H01 a cg:Heuristic ;
    rdfs:label "Hole depth-to-diameter ratio" ;
    cg:affectsKpi cg:kpi_machining_time,
        cg:kpi_rest_material_indicator,
        cg:kpi_tool_wear_proxy ;
    cg:appliesTo nx:STEP1HOLE,
        nx:STEP1HOLE_THREAD,
        nx:STEP1POCKET,
        nx:STEP1POCKET_THREAD,
        nx:STEP2HOLE,
        nx:STEP2HOLE_THREAD,
        nx:STEP2POCKET,
        nx:STEP2POCKET_THREAD,
        nx:STEP3HOLE,
        nx:STEP3HOLE1,
        nx:STEP3HOLE1_THREAD,
        nx:STEP3HOLE_THREAD,
        nx:STEP3POCKET,
        nx:STEP3POCKET_THREAD,
        nx:STEP4HOLE,
        nx:STEP4HOLE1,
        nx:STEP4HOLE1_THREAD,
        nx:STEP4HOLE_THREAD,
        nx:STEP4POCKET,
        nx:STEP4POCKET_THREAD,
        nx:STEP5HOLE,
        nx:STEP5HOLE1,
        nx:STEP5HOLE1_THREAD,
        nx:STEP5HOLE2,
        nx:STEP5HOLE2_THREAD,
        nx:STEP5HOLE_THREAD,
        nx:STEP5POCKET,
        nx:STEP5POCKET_THREAD,
        nx:STEP6HOLE,
        nx:STEP6HOLE1,
        nx:STEP6HOLE1_THREAD,
        nx:STEP6HOLE2,
        nx:STEP6HOLE2_THREAD,
        nx:STEP6HOLE_THREAD,
        nx:STEP6POCKET,
        nx:STEP6POCKET_THREAD ;
    cg:appliesToPattern "STEP*" ;
    cg:condition """{ SELECT ?f (MAX(?ratio) AS ?v_maxRatio) (COUNT(?s) AS ?v_sectionCount) WHERE {
    GRAPH <{ONTOLOGY}> { ?c cg:section ?s . ?s cg:diameterAttribute ?dp ; cg:depthToAttribute ?tp }
    GRAPH <{FACTS}> { ?f a ?c ; ?dp ?dia ; ?tp ?to }
    { GRAPH <{ONTOLOGY}> { ?s cg:depthFromAttribute ?fp } GRAPH <{FACTS}> { ?f ?fp ?from } }
    UNION
    { GRAPH <{ONTOLOGY}> { ?s cg:index 1 } BIND(0 AS ?from) }
    FILTER(?dia > 0)
    BIND((?to - ?from) / ?dia AS ?ratio)
  } GROUP BY ?f }
BIND(IF(?v_maxRatio <= ?t_hole_ld, cg:PASS, cg:FAIL) AS ?outcome)
""" ;
    cg:publishesValue "maxRatio",
        "sectionCount" ;
    cg:requires [ cg:attribute nx:DEPTH,
                nx:DIAMETER_1 ;
            cg:onClass nx:STEP1HOLE ],
        [ cg:attribute nx:DEPTH,
                nx:DIAMETER_1 ;
            cg:onClass nx:STEP1HOLE_THREAD ],
        [ cg:attribute nx:DEPTH,
                nx:DIAMETER_1 ;
            cg:onClass nx:STEP1POCKET ],
        [ cg:attribute nx:DEPTH,
                nx:DIAMETER_1 ;
            cg:onClass nx:STEP1POCKET_THREAD ],
        [ cg:attribute nx:DEPTH,
                nx:DEPTH_1,
                nx:DIAMETER_1,
