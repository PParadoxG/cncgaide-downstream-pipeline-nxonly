cg:COAXIAL a cg:RelationType ;
    rdfs:label "COAXIAL" ;
    skos:definition "The feature axes of the two features lie on one infinite line, within the angular and offset tolerances." ;
    cg:allowedPair [ cg:first nx:STEP ;
            cg:second nx:STEP ],
        [ cg:first nx:STEP ;
            cg:second nx:HOLES ],
        [ cg:first nx:HOLES ;
            cg:second nx:HOLES ],
        [ cg:first nx:STEP ;
            cg:second nx:BOSS_ROUND_STRAIGHT ],
        [ cg:first nx:HOLES ;
            cg:second nx:BOSS_ROUND_STRAIGHT ],
        [ cg:first nx:BOSS_ROUND_STRAIGHT ;
            cg:second nx:BOSS_ROUND_STRAIGHT ] ;
    cg:directed false ;
    cg:method "arithmetic over X/Y/Z_POSITION and X/Y/Z_ORIENTATION_D" .

cg:T_v_tool_angles a cg:Threshold ;
    rdfs:label "T_v_tool_angles" ;
    skos:definition "Included angles of standard V form tools." ;
    cg:member 30,
        45,
        60,
        90,
        120 ;
    cg:unit "deg" .

cg:kpi_min_required_tool_length a cg:KPIType,
        cg:KpiDerivation ;
    rdfs:label "kpi_min_required_tool_length",
        "minimum required tool length" ;
    skos:definition "Smallest tool stickout length allowing complete collision-free machining of a feature." ;
    cg:appliesTo nx:CORNER_NOTCH_RECTANGULAR,
        nx:CORNER_NOTCH_ROUND_CONCAVE,
        nx:CORNER_NOTCH_STRAIGHT,
        nx:CORNER_NOTCH_U_SHAPED,
        nx:GROOVE_AX_CIRCULAR_RECT,
        nx:GROOVE_INS_RAD_RECT,
        nx:HOLE_FREE_SHAPED_STRAIGHT,
        nx:HOLE_OBROUND_CURVED_STRAIGHT,
        nx:HOLE_OBROUND_STRAIGHT,
        nx:HOLE_RECTANGULAR_STRAIGHT,
        nx:HOLE_ROUND_INTERRUPTED_STRAIGHT,
        nx:HOLE_ROUND_TAPERED,
        nx:POCKET_CLOSED,
        nx:POCKET_FREE_SHAPED_STRAIGHT,
        nx:POCKET_OBROUND_CURVED_STRAIGHT,
        nx:POCKET_OBROUND_STRAIGHT,
        nx:POCKET_OPEN,
        nx:POCKET_RECTANGULAR_STRAIGHT,
        nx:POCKET_ROUND_TAPERED,
        nx:SIDE_NOTCH_RECTANGULAR,
        nx:SIDE_NOTCH_ROUND_CONCAVE,
        nx:SIDE_NOTCH_U_SHAPED,
        nx:SLOT_90_DEGREE,
        nx:SLOT_DOVE_TAIL,
        nx:SLOT_OBROUND,
        nx:SLOT_PARTIAL_OBROUND,
        nx:SLOT_PARTIAL_RECTANGULAR,
        nx:SLOT_PARTIAL_ROUND,
        nx:SLOT_PARTIAL_U_SHAPED,
        nx:SLOT_RECTANGULAR,
        nx:SLOT_ROUND,
        nx:SLOT_UPSIDE_DOWN_DOVE_TAIL,
        nx:SLOT_U_SHAPED,
        nx:SLOT_V_SHAPED,
        nx:STEP1HOLE,
        nx:STEP1HOLE_THREAD,
        nx:STEP1POCKET,
        nx:STEP1POCKET_THREAD,
        nx:STEP2HOLE,
        nx:STEP2HOLE_THREAD,
        nx:STEP2POCKET,
        nx:STEP2POCKET_THREAD,
        nx:STEP3HOLE,
        nx:STEP3HOLE1,
        nx:STEP3HOLE1_THREAD,
        nx:STEP3HOLE_THREAD,
        nx:STEP3POCKET,
        nx:STEP3POCKET_THREAD,
        nx:STEP4HOLE,
        nx:STEP4HOLE1,
        nx:STEP4HOLE1_THREAD,
        nx:STEP4HOLE_THREAD,
        nx:STEP4POCKET,
        nx:STEP4POCKET_THREAD,
        nx:STEP5HOLE,
        nx:STEP5HOLE1,
        nx:STEP5HOLE1_THREAD,
        nx:STEP5HOLE2,
        nx:STEP5HOLE2_THREAD,
        nx:STEP5HOLE_THREAD,
        nx:STEP5POCKET,
        nx:STEP5POCKET_THREAD,
        nx:STEP6HOLE,
        nx:STEP6HOLE1,
        nx:STEP6HOLE1_THREAD,
        nx:STEP6HOLE2,
        nx:STEP6HOLE2_THREAD,
        nx:STEP6HOLE_THREAD,
        nx:STEP6POCKET,
        nx:STEP6POCKET_THREAD ;
    cg:condition """GRAPH <{FACTS}> { ?f nx:DEPTH ?value }
""" ;
    cg:formula "DEPTH" ;
    cg:kind "feature" ;
    cg:kpiType cg:kpi_min_required_tool_length ;
    cg:unit "mm" ;
    cg:usesAttributePattern "DEPTH" ;
    cg:worseWhen "higher" .

cg:t_boss_clearance a cg:Threshold ;
    rdfs:label "t_boss_clearance" ;
    skos:definition "Minimum free space around a boss." ;
    cg:unit "mm" ;
    cg:value 3.0 .

cg:t_boss_diameter a cg:Threshold ;
    rdfs:label "t_boss_diameter" ;
    skos:definition "Minimum diameter of a round boss." ;
    cg:unit "mm" ;
    cg:value 3.0 .

cg:t_boss_hd a cg:Threshold ;
    rdfs:label "t_boss_hd" ;
    skos:definition "Maximum ratio of round-boss height to diameter." ;
    cg:value 4 .

cg:t_boss_slenderness a cg:Threshold ;
    rdfs:label "t_boss_slenderness" ;
    skos:definition "Maximum ratio of rectangular-boss height to its minimum thickness." ;
    cg:value 10 .

cg:t_corner_depth_ratio a cg:Threshold ;
    rdfs:label "t_corner_depth_ratio" ;
    skos:definition "Minimum ratio of pocket corner radius to pocket depth." ;
    cg:value 0.33 .

cg:t_corner_radius a cg:Threshold ;
    rdfs:label "t_corner_radius" ;
    skos:definition "Minimum concave internal corner radius of a pocket." ;
    cg:unit "mm" ;
    cg:value 1.0 .

cg:t_crossing_angle a cg:Threshold ;
    rdfs:label "t_crossing_angle" ;
    skos:definition "Minimum crossing angle between two intersecting holes." ;
    cg:unit "deg" ;
    cg:value 45 .

cg:t_hole_ld a cg:Threshold ;
    rdfs:label "t_hole_ld" ;
    skos:definition "Maximum depth-to-diameter ratio of a hole section." ;
    cg:value 4 .

cg:t_hole_near a cg:Threshold ;
    rdfs:label "t_hole_near" ;
    skos:definition "Two holes are nearby when their axis spacing is at most this multiple of the larger base diameter." ;
    cg:value 3 .

cg:t_hole_web a cg:Threshold ;
    rdfs:label "t_hole_web" ;
    skos:definition "Minimum material web between two parallel holes." ;
    cg:unit "mm" ;
    cg:value 2.0 .

cg:t_min_wall a cg:Threshold ;
    rdfs:label "t_min_wall" ;
    skos:definition "Minimum remaining wall thickness around a removal feature." ;
    cg:unit "mm" ;
    cg:value 1.0 .

cg:t_pocket_entry_depth a cg:Threshold ;
    rdfs:label "t_pocket_entry_depth" ;
    skos:definition "Pocket depth from which a plunge entry hole is expected." ;
    cg:unit "mm" ;
    cg:value 10 .

cg:t_pocket_gap a cg:Threshold ;
    rdfs:label "t_pocket_gap" ;
    skos:definition "Minimum side-wall clearance between two pockets." ;
    cg:unit "mm" ;
    cg:value 3.0 .

cg:t_pocket_ld a cg:Threshold ;
    rdfs:label "t_pocket_ld" ;
    skos:definition "Maximum ratio of pocket depth to its most restrictive width." ;
    cg:value 5 .

cg:t_slot_gap a cg:Threshold ;
    rdfs:label "t_slot_gap" ;
    skos:definition "Minimum opening clearance between two slots." ;
    cg:unit "mm" ;
    cg:value 3.0 .

cg:t_slot_ld a cg:Threshold ;
    rdfs:label "t_slot_ld" ;
    skos:definition "Maximum ratio of slot depth to slot width." ;
    cg:value 4 .

cg:t_slot_width a cg:Threshold ;
    rdfs:label "t_slot_width" ;
    skos:definition "Minimum slot width." ;
    cg:unit "mm" ;
    cg:value 3.0 .

cg:t_throughcut_corner_radius a cg:Threshold ;
    rdfs:label "t_throughcut_corner_radius" ;
    skos:definition "Minimum concave internal corner radius of a through cut." ;
    cg:unit "mm" ;
    cg:value 3.0 .

cg:tol_angle a cg:Threshold ;
    rdfs:label "tol_angle" ;
    skos:definition "Two angles within this distance count as one angle." ;
    cg:unit "deg" ;
    cg:value 1.0 .

cg:tol_diameter a cg:Threshold ;
    rdfs:label "tol_diameter" ;
    skos:definition "Two diameters within this distance count as one diameter." ;
    cg:unit "mm" ;
    cg:value 0.05 .

cg:tol_draft_zero a cg:Threshold ;
    rdfs:label "tol_draft_zero" ;
    skos:definition "A wall within this angle of vertical counts as vertical." ;
    cg:unit "deg" ;
    cg:value 0.5 .

