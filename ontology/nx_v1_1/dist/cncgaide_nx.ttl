    cg:scope "feature" ;
    cg:statement "Keep the depth-to-diameter ratio of every section of a hole at or below t_hole_ld." ;
    cg:usesAttributePattern "DEPTH",
        "DEPTH_k",
        "DIAMETER_k" ;
    cg:usesThreshold cg:t_hole_ld .

cg:H03 a cg:Heuristic ;
    rdfs:label "Pocket depth-to-width ratio" ;
    cg:affectsKpi cg:kpi_collision_indicator,
        cg:kpi_rest_material_indicator,
        cg:kpi_tool_wear_proxy ;
    cg:appliesTo nx:POCKET_RECTANGULAR_STRAIGHT ;
    cg:appliesToPattern "POCKET_RECTANGULAR_STRAIGHT" ;
    cg:condition """GRAPH <{FACTS}> { ?f nx:DEPTH ?v_DEPTH ; nx:WIDTH ?v_WIDTH ; nx:LENGTH ?v_LENGTH }
BIND(IF(?v_WIDTH < ?v_LENGTH, ?v_WIDTH, ?v_LENGTH) AS ?v_restrictiveWidth)
FILTER(?v_restrictiveWidth > 0)
BIND(?v_DEPTH / ?v_restrictiveWidth AS ?v_depthToMinWidth)
BIND(IF(?v_depthToMinWidth <= ?t_pocket_ld, cg:PASS, cg:FAIL) AS ?outcome)
""" ;
    cg:publishesValue "DEPTH",
        "LENGTH",
        "WIDTH",
        "depthToMinWidth",
        "restrictiveWidth" ;
    cg:requires [ cg:attribute nx:DEPTH,
                nx:LENGTH,
                nx:WIDTH ;
            cg:onClass nx:POCKET_RECTANGULAR_STRAIGHT ] ;
    cg:scope "feature" ;
    cg:statement "Keep the depth of a rectangular pocket at or below t_pocket_ld times the smaller of its width and length." ;
    cg:usesAttributePattern "DEPTH",
        "LENGTH",
        "WIDTH" ;
    cg:usesThreshold cg:t_pocket_ld .

cg:H06 a cg:Heuristic ;
    rdfs:label "Minimum round-boss diameter" ;
    cg:affectsKpi cg:kpi_workpiece_stiffness ;
    cg:appliesTo nx:BOSS_ROUND_STRAIGHT,
        nx:BOSS_ROUND_STRAIGHT_THREAD ;
    cg:appliesToPattern "BOSS_ROUND_STRAIGHT",
        "BOSS_ROUND_STRAIGHT_THREAD" ;
    cg:condition """GRAPH <{FACTS}> { ?f nx:DIAMETER ?v_DIAMETER }
BIND(IF(?v_DIAMETER >= ?t_boss_diameter, cg:PASS, cg:FAIL) AS ?outcome)
""" ;
    cg:publishesValue "DIAMETER" ;
    cg:requires [ cg:attribute nx:DIAMETER ;
            cg:onClass nx:BOSS_ROUND_STRAIGHT ],
        [ cg:attribute nx:DIAMETER ;
            cg:onClass nx:BOSS_ROUND_STRAIGHT_THREAD ] ;
    cg:scope "feature" ;
    cg:statement "Keep the diameter of a round boss at or above t_boss_diameter." ;
    cg:usesAttributePattern "DIAMETER" ;
    cg:usesThreshold cg:t_boss_diameter .

cg:H07 a cg:Heuristic ;
    rdfs:label "Round-boss height-to-diameter ratio" ;
    cg:affectsKpi cg:kpi_rest_material_indicator,
        cg:kpi_workpiece_stiffness ;
    cg:appliesTo nx:BOSS_ROUND_STRAIGHT,
        nx:BOSS_ROUND_STRAIGHT_THREAD ;
    cg:appliesToPattern "BOSS_ROUND_STRAIGHT",
        "BOSS_ROUND_STRAIGHT_THREAD" ;
    cg:condition """GRAPH <{FACTS}> { ?f nx:DEPTH ?v_DEPTH ; nx:DIAMETER ?v_DIAMETER }
FILTER(?v_DIAMETER > 0)
BIND(?t_boss_hd * ?v_DIAMETER AS ?v_heightLimit)
BIND(?v_DEPTH / ?v_DIAMETER AS ?v_heightToDiameter)
BIND(IF(?v_DEPTH <= ?v_heightLimit, cg:PASS, cg:FAIL) AS ?outcome)
""" ;
    cg:publishesValue "DEPTH",
        "DIAMETER",
        "heightLimit",
        "heightToDiameter" ;
    cg:requires [ cg:attribute nx:DEPTH,
                nx:DIAMETER ;
            cg:onClass nx:BOSS_ROUND_STRAIGHT ],
        [ cg:attribute nx:DEPTH,
                nx:DIAMETER ;
            cg:onClass nx:BOSS_ROUND_STRAIGHT_THREAD ] ;
    cg:scope "feature" ;
    cg:statement "Keep the height of a round boss at or below t_boss_hd times its diameter." ;
    cg:usesAttributePattern "DEPTH",
        "DIAMETER" ;
    cg:usesThreshold cg:t_boss_hd .

cg:H10 a cg:Heuristic ;
    rdfs:label "Minimum pocket corner radius" ;
    cg:affectsKpi cg:kpi_tool_changes ;
    cg:appliesTo nx:POCKET_CLOSED,
        nx:POCKET_FREE_SHAPED_STRAIGHT,
        nx:POCKET_OPEN ;
    cg:appliesToPattern "POCKET_CLOSED",
        "POCKET_FREE_SHAPED_STRAIGHT",
        "POCKET_OPEN" ;
    cg:condition """GRAPH <{FACTS}> { ?f nx:MIN_RADIUS ?v_MIN_RADIUS }
BIND(IF(?v_MIN_RADIUS >= ?t_corner_radius, cg:PASS, cg:FAIL) AS ?outcome)
""" ;
    cg:publishesValue "MIN_RADIUS" ;
    cg:requires [ cg:attribute nx:MIN_RADIUS ;
            cg:onClass nx:POCKET_CLOSED ],
        [ cg:attribute nx:MIN_RADIUS ;
            cg:onClass nx:POCKET_FREE_SHAPED_STRAIGHT ],
        [ cg:attribute nx:MIN_RADIUS ;
            cg:onClass nx:POCKET_OPEN ] ;
    cg:scope "feature" ;
    cg:statement "Keep the minimum concave internal corner radius of a pocket at or above t_corner_radius." ;
    cg:usesAttributePattern "MIN_RADIUS" ;
    cg:usesThreshold cg:t_corner_radius .

cg:H11 a cg:Heuristic ;
    rdfs:label "Minimum remaining pocket floor thickness" ;
    cg:affectsKpi cg:kpi_collision_indicator,
        cg:kpi_rest_material_indicator,
        cg:kpi_tool_wear_proxy ;
    cg:appliesTo nx:POCKET_CLOSED,
        nx:POCKET_FREE_SHAPED_STRAIGHT,
        nx:POCKET_OBROUND_CURVED_STRAIGHT,
        nx:POCKET_OBROUND_STRAIGHT,
        nx:POCKET_OPEN,
        nx:POCKET_RECTANGULAR_STRAIGHT,
        nx:POCKET_ROUND_TAPERED ;
    cg:appliesToPattern "POCKET_*" ;
    cg:condition """GRAPH <{FACTS}> { ?f cg:derived_floor_thickness ?v_derived_floor_thickness }
BIND(IF(?v_derived_floor_thickness >= ?t_floor, cg:PASS, cg:FAIL) AS ?outcome)
""" ;
    cg:publishesValue "derived_floor_thickness" ;
    cg:requires [ cg:attribute cg:derived_floor_thickness ;
            cg:onClass nx:POCKET_CLOSED ],
        [ cg:attribute cg:derived_floor_thickness ;
            cg:onClass nx:POCKET_FREE_SHAPED_STRAIGHT ],
        [ cg:attribute cg:derived_floor_thickness ;
            cg:onClass nx:POCKET_OBROUND_CURVED_STRAIGHT ],
        [ cg:attribute cg:derived_floor_thickness ;
            cg:onClass nx:POCKET_OBROUND_STRAIGHT ],
        [ cg:attribute cg:derived_floor_thickness ;
            cg:onClass nx:POCKET_OPEN ],
        [ cg:attribute cg:derived_floor_thickness ;
            cg:onClass nx:POCKET_RECTANGULAR_STRAIGHT ],
        [ cg:attribute cg:derived_floor_thickness ;
            cg:onClass nx:POCKET_ROUND_TAPERED ] ;
    cg:scope "feature" ;
    cg:statement "Keep the remaining floor thickness below a pocket at or above t_floor." ;
    cg:usesAttributePattern "derived_floor_thickness" ;
    cg:usesThreshold cg:t_floor .

cg:H12 a cg:Heuristic ;
    rdfs:label "Minimum web between holes" ;
    cg:affectsKpi cg:kpi_collision_indicator,
        cg:kpi_workpiece_stiffness ;
    cg:appliesTo nx:STEP1HOLE,
        nx:STEP1HOLE_THREAD,
        nx:STEP1POCKET,
        nx:STEP1POCKET_THREAD,
        nx:STEP2HOLE,
        nx:STEP2HOLE_THREAD,
        nx:STEP2POCKET,
        nx:STEP2POCKET_THREAD,
        nx:STEP3HOLE,
        nx:STEP3HOLE1,
        nx:STEP3HOLE1_THREAD,
        nx:STEP3HOLE_THREAD,
        nx:STEP3POCKET,
        nx:STEP3POCKET_THREAD,
        nx:STEP4HOLE,
        nx:STEP4HOLE1,
        nx:STEP4HOLE1_THREAD,
        nx:STEP4HOLE_THREAD,
        nx:STEP4POCKET,
        nx:STEP4POCKET_THREAD,
        nx:STEP5HOLE,
        nx:STEP5HOLE1,
        nx:STEP5HOLE1_THREAD,
        nx:STEP5HOLE2,
        nx:STEP5HOLE2_THREAD,
        nx:STEP5HOLE_THREAD,
        nx:STEP5POCKET,
        nx:STEP5POCKET_THREAD,
        nx:STEP6HOLE,
        nx:STEP6HOLE1,
        nx:STEP6HOLE1_THREAD,
        nx:STEP6HOLE2,
        nx:STEP6HOLE2_THREAD,
        nx:STEP6HOLE_THREAD,
        nx:STEP6POCKET,
        nx:STEP6POCKET_THREAD ;
    cg:appliesToPattern "STEP*" ;
    cg:condition """GRAPH <{ONTOLOGY}> { ?clsA cg:entryDiameterAttribute ?dpA . ?clsB cg:entryDiameterAttribute ?dpB }
GRAPH <{FACTS}> { ?rel cg:axisSpacing ?v_axisSpacing . ?a ?dpA ?v_entryDiameterA . ?b ?dpB ?v_entryDiameterB }
BIND(?v_axisSpacing - (?v_entryDiameterA + ?v_entryDiameterB) / 2 AS ?v_web)
BIND(IF(?v_web >= ?t_hole_web, cg:PASS, cg:FAIL) AS ?outcome)
""" ;
    cg:publishesValue "axisSpacing",
        "entryDiameterA",
        "entryDiameterB",
        "web" ;
    cg:relationType cg:HOLE_SPACING ;
    cg:requires [ cg:attribute nx:DIAMETER_1 ;
            cg:onClass nx:STEP1HOLE ],
        [ cg:attribute nx:DIAMETER_1 ;
            cg:onClass nx:STEP1HOLE_THREAD ],
        [ cg:attribute nx:DIAMETER_1 ;
            cg:onClass nx:STEP1POCKET ],
        [ cg:attribute nx:DIAMETER_1 ;
            cg:onClass nx:STEP1POCKET_THREAD ],
        [ cg:attribute nx:DIAMETER_1 ;
            cg:onClass nx:STEP2HOLE ],
        [ cg:attribute nx:DIAMETER_1 ;
            cg:onClass nx:STEP2HOLE_THREAD ],
        [ cg:attribute nx:DIAMETER_1 ;
            cg:onClass nx:STEP2POCKET ],
        [ cg:attribute nx:DIAMETER_1 ;
            cg:onClass nx:STEP2POCKET_THREAD ],
        [ cg:attribute nx:DIAMETER_1 ;
